# khy-os free-test — 前端生产 env
# 放在 apps/ai-frontend/.env.production (从 deploy/free-test/ 拷过去)。
# Vite 构建时注入到 import.meta.env (见 src/api/request.js:13)。
# 全免费: API 指 Supabase EF, AI 流式指 khyos-ai EF。

# 核心 REST API → Supabase Edge Function khyos-api
VITE_AI_API_BASE_URL=https://REPLACE_WITH_SUPABASE_REF.supabase.co/functions/v1/khyos-api

# AI 流式 (LLM SSE) → Supabase Edge Function khyos-ai
VITE_AI_STREAM_URL=https://REPLACE_WITH_SUPABASE_REF.supabase.co/functions/v1/khyos-ai

# HTTP 超时 (流式 chat 走 fetch 不受此限)
VITE_AI_HTTP_TIMEOUT_MS=30000

# 路由 base (部署到根路径留空; 子应用才设)
VITE_AI_ROUTER_BASE=
