{
  "name": "Khy-OS",
  "private": true,
  "//packageManager": "pnpm 是仓库 workspace 的唯一安装入口；独立构建子项目仍按 pnpm-workspace.yaml 说明使用 npm。packageManager 固定 corepack 版本。",
  "packageManager": "pnpm@10.18.0",
  "workspaces": [
    "platform/packages/shared",
    "platform/packages/ui-shared",
    "services/backend",
    "services/ai-backend",
    "apps/ai-frontend",
    "software/khyquant/frontend"
  ],
  "//": "任务入口按域分组，命名规约 <域>:<动作>[:<变体>] 见 docs/03_DESIGN_设计/[DESIGN-ARCH-068] 仓库层级板块规范.md 第五节；逐条说明见 docs/07_OPS_运维/[OPS-MAN-174] 任务入口总表.md。每个入口都指向一个已存在的脚本文件——check:layout 的 dangling-task 规则会守住这条。",
  "scripts": {
    "preinstall": "node scripts/install/link-shared-dev.js",
    "//check": "── CI 守卫：会亮红灯的检查（scripts/ci/*）──",
    "check:layout": "node scripts/ci/check-repo-layout.js",
    "check:gov-rules": "node scripts/ci/check-gov-rules.js",
    "check:version-sync": "node scripts/ci/check-version-sync.js",
    "check:change-safety": "node scripts/ci/check-change-safety.js --changed",
    "check:agent-rules": "node scripts/ci/check-agent-rules.js --changed",
    "check:quality-gates": "node scripts/quality-gate/index.js --mode release",
    "quality:gate": "npm run check:quality-gates",
    "quality:pr": "node scripts/quality-gate/index.js --mode pr",
    "check:leaf-contract": "node scripts/ci/check-leaf-contract.js --changed",
    "check:arch-debt": "node services/backend/scripts/archDebtScan.js",
    "check:arch-debt:changed": "node services/backend/scripts/archDebtScan.js --changed",
    "check:node-syntax": "node scripts/ci/check-node-syntax.js",
    "check:python-syntax": "node scripts/ci/run-python.js scripts/ci/check-python-syntax.py",
    "check:duplication": "node scripts/ci/check-duplication.js",
    "check:duplication:gate": "node scripts/ci/check-duplication.js --gate",
    "check:duplication:strict": "node scripts/ci/check-duplication.js --gate --strict-warnings",
    "check:duplication:baseline": "node scripts/ci/check-duplication.js --write-baseline",
    "check:manifest-sync": "node scripts/ci/run-python.js scripts/release/check_manifest_sync.py",
    "check:khyos-pins": "node scripts/release/pin-khyos-toolchain.js --lint",
    "check:small-model:safety": "npm run check:change-safety -- --promote=sensitive-paths && npm run check:agent-rules && npm run check:leaf-contract && npm run check:model-hardcoding && npm run check:flag-registry",
    "check:maintainer:safety": "node --test scripts/tests/maintainerMapDocCoverage.test.js",
    "check:ai-chat-ui-control-request": "npm exec --workspace services/backend -- jest tests/aiChat.controlRequest.ui.test.js --runInBand",
    "restore-check": "node scripts/restore/restore-check.js",
    "verify-install": "node scripts/lib/ext-run.js khy-installer verify",
    "check:flag-registry": "node scripts/ci/check-flag-registry.js",
    "check:model-hardcoding": "node scripts/ci/check-model-hardcoding.js",
    "check:pattern-coverage": "node scripts/ci/check-pattern-coverage.js",
    "check:tool-contract": "node scripts/ci/check-tool-contract.js",
    "check:skill-evals": "node scripts/ci/check-skill-evals.js",
    "check:skill-scenarios": "node scripts/ci/check-skill-scenarios.js",
    "check:lifecycle-policy": "node scripts/ci/check-lifecycle-policy.js",
    "check:moonbit-layout": "node scripts/ci/check-moonbit-layout.js",
    "check:frontend-size": "node scripts/ci/check-frontend-size.js",
    "check:dep-size": "node scripts/ci/check-dependency-size.js",
    "check:build-artifacts": "node scripts/ci/check-build-artifacts.js",
    "check:runtime-placement": "node scripts/ci/check-runtime-placement.js",
    "check:json-schemas": "node scripts/ci/validate-json-schemas.js",
    "check:protocol-contracts": "node scripts/ci/validate-protocol-contracts.js",
    "check:reliability": "node scripts/ci/validate-reliability.js",
    "check:structure": "npm run check:layout && npm run check:gov-rules && npm run check:pattern-coverage && npm run check:json-schemas && npm run check:node-syntax && npm run check:build-artifacts && npm run check:runtime-placement",
    "check:changed": "npm run check:change-safety && npm run check:agent-rules && npm run check:leaf-contract",
    "//clean": "默认干跑，只打印将删除的目录与体积；加 --apply 才真删。白名单见 scripts/maintenance/clean.js 顶部 TARGETS，只含构建与测试产物，绝不触及源码、锁文件、用户配置、.khy/checkpoints 与凭据。",
    "clean": "node scripts/maintenance/clean.js",
    "clean:apply": "node scripts/maintenance/clean.js --apply",
    "//install:prod": "自建服务端的最小安装：只装 services/backend 的运行时闭包，不装任何 dev/lint/test/build 依赖。pip 与 npm 渠道发的是 bundle.mjs，不走这条路径。",
    "install:prod": "corepack pnpm install --prod --filter khy-os-backend... --frozen-lockfile",
    "install:core": "corepack pnpm install --frozen-lockfile --filter khy-os-backend... --filter khy-ai-backend... --filter @khy/shared...",
    "install:frontend": "corepack pnpm install --frozen-lockfile --filter khy-ai-frontend... --filter quant-trading-frontend...",
    "install:mobile": "corepack pnpm install --frozen-lockfile --filter @khy-os/mobile-companion...",
    "install:all": "corepack pnpm install --frozen-lockfile",
    "//docs": "── 文档站构建与体检（scripts/docs/*）──",
    "docs:build": "node scripts/docs/mermaid-embed/ensure-mermaid.mjs && node scripts/docs/build_docs_site.js",
    "docs:mermaid": "node scripts/docs/mermaid-embed/ensure-mermaid.mjs",
    "docs:verify": "node scripts/docs/verify_docs_site.js",
    "docs:lint": "node scripts/docs/lint_docs_widgets.js",
    "docs:check-beginner": "node scripts/docs/check_beginner_docs.js",
    "docs:pdf": "node scripts/docs/md-to-pdf.js",
    "docs:gen-evolution-prompts": "node scripts/docs/gen-evolution-prompts.js",
    "//test": "── 测试。跑单个文件用 npm run test:one -- <path>，不为每个场景登记入口。Node 22+ 的 --test 把位置参数当 glob 而非目录，故必须写通配并加引号（裸目录会被当成 entry point，报 Cannot find module）──",
    "test:one": "node --test",
    "test:scripts": "node --test \"scripts/tests/**/*.test.js\"",
    "test:docs": "node --test \"scripts/docs/**/*.test.js\"",
    "test:backend": "npm run test:all --workspace services/backend",
    "test:frontend": "npm test --prefix apps/ai-frontend",
    "test:all": "npm run test:scripts && npm run test:docs && npm run test:backend",
    "cover-unit": "node scripts/quality-gate/coverage.js --scope=unit",
    "cover-integration": "node scripts/quality-gate/coverage.js --scope=integration",
    "merge-coverage": "node scripts/quality-gate/merge-coverage.js",
    "//maintainer": "── 维护映射表与生成物（真源 docs/_维护者/维护映射表.json）──",
    "maintainer:map": "node scripts/ci/print-maintainer-map.js",
    "maintainer:triage": "node scripts/lib/ext-run.js khy-diagnostics triage",
    "maintenance:codeowners": "node scripts/maintenance/gen-codeowners.js",
    "maintenance:triage-doc": "node scripts/lib/ext-run.js khy-diagnostics triage --gen-doc",
    "maintenance:pattern-registry": "node scripts/ci/generate-pattern-registry.js",
    "maintenance:dimension-health": "node scripts/ci/export-dimension-health.js",
    "maintenance:quality-dashboard": "node scripts/ci/export-quality-dashboard.js",
    "//gate": "── 发布门（scripts/release/*）──",
    "gate:release": "node scripts/release/release-gate.js",
    "gate:release:all": "node scripts/release/release-gate.js --tier=all",
    "gate:release:json": "node scripts/release/release-gate.js --json",
    "gate:runtime-placement": "node scripts/release/verify-runtime-placement.js",
    "gate:changelog-new": "node scripts/release/changelog-new.js",
    "//restore": "── 源码恢复流程（scripts/restore/*，18 个阶段 1:1 映射）──",
    "restore:plan": "node scripts/restore/restore-plan.js",
    "restore:check": "node scripts/restore/restore-check.js",
    "restore:check:archive": "node scripts/restore/restore-check-archive.js",
    "restore:check:crypto": "node scripts/restore/restore-check-crypto.js",
    "restore:check:format": "node scripts/restore/restore-check-format.js",
    "restore:authorize": "node scripts/restore/restore-authorize.js",
    "restore:conflicts": "node scripts/restore/restore-conflicts.js",
    "restore:resolve": "node scripts/restore/restore-resolve.js",
    "restore:apply": "node scripts/restore/restore-apply.js",
    "restore:converge": "node scripts/restore/restore-converge.js",
    "restore:verify-complete": "node scripts/restore/restore-verify-complete.js",
    "restore:recourse": "node scripts/restore/restore-recourse.js",
    "restore:navigate": "node scripts/restore/restore-navigate.js",
    "restore:ledger": "node scripts/restore/restore-ledger.js",
    "restore:provenance": "node scripts/restore/restore-provenance.js",
    "restore:trace": "node scripts/restore/restore-trace.js",
    "restore:effect-probe": "node scripts/restore/restore-effect-probe.js",
    "restore:field-attribution": "node scripts/restore/restore-field-attribution.js",
    "//portable": "── 便携版构建与打包（extensions/scripts/khy-portable/*，经 ext-run 派发）──",
    "portable:build:dev": "node scripts/lib/ext-run.js khy-portable build --kind portable-dev",
    "portable:build:runtime": "node scripts/lib/ext-run.js khy-portable build --kind portable-runtime",
    "portable:plan:dev": "node scripts/lib/ext-run.js khy-portable build --kind portable-dev --plan",
    "portable:plan:runtime": "node scripts/lib/ext-run.js khy-portable build --kind portable-runtime --plan",
    "portable:package": "node scripts/lib/ext-run.js khy-portable package",
    "portable:package:runtime": "node scripts/lib/ext-run.js khy-portable package --kind runtime",
    "portable:package:dev": "node scripts/lib/ext-run.js khy-portable package --kind dev",
    "portable:verify": "node scripts/lib/ext-run.js khy-portable verify",
    "portable:repair": "node scripts/lib/ext-run.js khy-portable repair",
    "//install": "── 安装与自检（extensions/scripts/khy-installer/*，经 ext-run 派发）──",
    "hooks:install": "node scripts/lib/ext-run.js khy-installer hooks",
    "verify:install": "node scripts/lib/ext-run.js khy-installer verify",
    "//sync": "── 双仓镜像同步（scripts/sync/*）。断网或令牌失效时推送失败会记入 .khy/sync/mirror-queue.json，恢复后由下一次提交或 sync:mirrors:retry 补推 ──",
    "sync:mirrors": "node scripts/sync/mirror-sync.js push",
    "sync:mirrors:retry": "node scripts/sync/mirror-sync.js retry",
    "sync:mirrors:status": "node scripts/sync/mirror-sync.js status",
    "//bench": "── 性能基准（extensions/scripts/khy-diagnostics/bench/*，经 ext-run 派发）──",
    "bench:startup": "node scripts/lib/ext-run.js khy-diagnostics bench-startup",
    "bench:startup-probe": "node scripts/lib/ext-run.js khy-diagnostics bench-startup-probe",
    "bench:ab-compare": "node scripts/lib/ext-run.js khy-diagnostics bench-ab-compare",
    "bench:git-spawn": "node scripts/lib/ext-run.js khy-diagnostics bench-git-spawn",
    "//diagnostics": "── 诊断（extensions/scripts/khy-diagnostics/*，经 ext-run 派发）──",
    "doctor:hydration": "node scripts/lib/ext-run.js khy-diagnostics doctor-hydration",
    "doctor:model-types": "node scripts/lib/ext-run.js khy-diagnostics doctor-model-types",
    "doctor:storage": "node scripts/lib/ext-run.js khy-diagnostics doctor-storage",
    "//memory": "── 记忆系统管理（scripts/memory/*）──",
    "memory:clear": "node scripts/memory/clear-memory.js",
    "memory:clear:apply": "node scripts/memory/clear-memory.js --apply",
    "memory:clear:p0": "node scripts/memory/clear-memory.js --level=p0",
    "memory:clear:p1": "node scripts/memory/clear-memory.js --level=p1",
    "memory:clear:p2": "node scripts/memory/clear-memory.js --level=p2",
    "memory:restore": "node scripts/memory/restore-memory.js",
    "memory:restore:all": "node scripts/memory/restore-memory.js --all",
    "memory:restore:file": "node scripts/memory/restore-memory.js --file",
    "memory:restore:type": "node scripts/memory/restore-memory.js --type",
    "//frontend": "── 前端代码清理（scripts/frontend/*）──",
    "frontend:cleanup-console": "node scripts/frontend/cleanup-console.js",
    "frontend:cleanup-console:apply": "node scripts/frontend/cleanup-console.js --apply",
    "frontend:cleanup-console:remove": "node scripts/frontend/cleanup-console.js --remove",
    "frontend:fix-colors": "node scripts/frontend/fix-hardcoded-colors.js",
    "frontend:fix-colors:apply": "node scripts/frontend/fix-hardcoded-colors.js --apply",
    "frontend:fix-var": "node scripts/frontend/fix-var-declarations.js",
    "frontend:fix-var:apply": "node scripts/frontend/fix-var-declarations.js --apply",
    "//backend": "── 后端代码清理（scripts/backend/*）──",
    "backend:fix-deprecated": "node scripts/backend/fix-deprecated-encoding.js",
    "backend:fix-deprecated:apply": "node scripts/backend/fix-deprecated-encoding.js --apply",
    "install:core:ignore-scripts": "corepack pnpm install --frozen-lockfile --ignore-scripts --filter khy-os-backend... --filter khy-ai-backend... --filter @khy/shared..."
  },
  "//devDependencies": "根级 devDependencies 只放**仓库级工具链**——被 scripts/ 下的治理脚本直接调用的东西。业务运行时依赖一律声明在拥有它的 workspace 里，否则 `npm ci --omit=dev` 会把运行时代码需要的包一起省掉。2026-08-25 依据这条规则移出两类：① 5 个 @opentelemetry/* —— 链路追踪由 KHY_OTEL_ENABLED 门控、在 observability/otel.js 里 lazy require，已声明为 services/backend 的 optional peerDependencies，根级再声明一遍等于让每台开发机无条件装 36 MB 默认不启用的包；② node-cron —— 它是 software/khyquant/services/instrumentSyncService.js 的运行时依赖（非 dev），已移到 services/backend/dependencies。",
  "devDependencies": {
    "ajv": "^6.15.0",
    "c8": "^10.1.3",
    "esbuild": "^0.25.12"
  },
  "//overrides": "iconv-lite 收敛成单份：发布 bundle 由 esbuild 按解析路径内联，同一个包装在几个 node_modules 下就被打进去几遍。0.6.3 是 whatwg-encoding/encoding-sniffer 点名要的版本；body-parser/raw-body（~0.4.24）与 @inquirer/external-editor（^0.7.0）只用 decode/encodingExists，三个版本签名一致。",
  "overrides": {
    "iconv-lite": "0.6.3",
    "@inquirer/external-editor": {
      "iconv-lite": "0.6.3"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true
  },
  "//install:profiles": "install:core 是后端/共享包的日常最小开发闭包；install:frontend、install:mobile 按需补齐对应开发工具；install:all 用于全仓构建或兼容旧流程。所有入口都由 pnpm-workspace.yaml 驱动。"
}
