      "rel": ".khy",
      "accessor": "getDataHome()",
      "role": "应用层运行态数据"
    },
    "khyos": {
      "rel": ".khyos",
      "accessor": "getBaseHome()",
      "role": "底座层运行态数据"
    },
    "state": {
      "rel": ".state",
      "accessor": "getStateHome()",
      "role": "代码态运行残留根（本篇新增，尚未启用）"
    }
  },
  "tiers": [
    {
      "id": "T0-authoritative",
      "semantics": "删了就丢、无法再生",
      "budget": 50,
      "recursiveDelete": false,
      "backup": "home-user",
      "children": [
        "config",
        "state",
        "secrets"
      ]
    },
    {
      "id": "T1-domains",
      "semantics": "业务领域数据，按领域轴劈",
      "budget": 50,
      "recursiveDelete": "policy",
      "backup": "home-app",
      "children": [
        "sessions",
        "memory",
        "ai",
        "agents",
        "tools",
        "desktop",
        "telemetry",
        "secrets",
        "_unsorted"
      ],
      "perChildBudget": 20
    },
    {
      "id": "T2-regenerable",
      "semantics": "删了能重建（缓存、派生索引）",
      "budget": 50,
      "recursiveDelete": true,
      "backup": "none"
    },
    {
      "id": "T3-archives",
      "semantics": "只追加只轮转，永不裁剪",
      "budget": 50,
      "recursiveDelete": false,
      "compressForbidden": true,
      "backup": "home-project"
    },
    {
      "id": "T4-transient",
      "semantics": "进程副产物与一次性诊断转储",
      "budget": 50,
      "recursiveDelete": true,
      "backup": "none",
      "children": [
        "scratch"
      ]
    }
  ],
  "tierPrefixIsNotId": true,
  "tierPrefixNote": "T0-…T4- 的数字前缀不是规则 ID 也不是文档编号，不可解析引用、不参与 [XXX-YYY-NNN] 编号校验；跨文引用一律写档名全称（T0-authoritative，而非 T0）。裁决见 [DESIGN-LAY-007] §10 Q4。",
  "topLevel": {
    "maxAddressable": 20,
    "budgetNote": "顶层预算只计可寻址项。安装产物在此登记并显式不搬（搬 node_modules 会破坏 npm 按名解析），但必须在报告里单列可见，不得静默隐藏。裁决见 §10 Q2。",
    "installArtifacts": [
      {
        "name": "node_modules",
        "moved": false,
        "reason": "npm 按名解析依赖，搬动即破坏安装与 require"
      },
      {
        "name": "khy_os.egg-info",
        "moved": false,
        "reason": "setuptools 构建元数据，由 pip 构建再生"
      }
    ]
  },
  "seedEntries": [
