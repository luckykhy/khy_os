# Khy AI Frontend 环境变量模板
#
# 复制为 .env.local（或 .env）后按需填写。本文件只列出 src/ 里**真正被读取**的
# VITE_ 变量——每个都附了读取位置，方便核对。Vite 只会暴露 VITE_ 前缀的变量，
# 且 `import.meta.env.X || 默认值` 意味着留空即回落，不会报错。
#
# 端口真源：services/backend/src/constants/serviceDefaults.js
#   BACKEND_PORT = 3000        （后端 HTTP / WebSocket 共用端口）
#   WEB_FRONTEND_PORT = 8090   （网关管理面板的 dev server 端口）

# ── API 基址（唯一真源）─────────────────────────────────────────────
# 留空 = 同源部署（推荐：后端用 server.js 直接托管 dist/，前端与 API 同端口）。
# 只有 dev 调试或前后端分离部署时才需要设，且**必须带 /api 前缀**——
# 前端所有调用路径本身就以 /api 开头。
VITE_AI_API_BASE_URL=

# ── HTTP 超时（可选）───────────────────────────────────────────────
# 单次 REST 调用的超时（毫秒），默认 30000。流式对话走 fetch() 不受此限制。
VITE_AI_HTTP_TIMEOUT_MS=30000

# ── 路由前缀（可选）───────────────────────────────────────────────
# 应用部署在非根路径时设置，例如 /khyos ⇒ /khyos/login。留空 = 根路径。
VITE_AI_ROUTER_BASE=

# ── WebSocket 行为（可选，仅 AI 对话）──────────────────────────────
# 鉴权握手超时 / 心跳间隔 / 心跳无响应超时 / 空闲超时 / 停止兜底（均为毫秒）。
VITE_AI_WS_AUTH_TIMEOUT_MS=
VITE_AI_WS_HEARTBEAT_INTERVAL_MS=
VITE_AI_WS_HEARTBEAT_PONG_TIMEOUT_MS=
VITE_AI_WS_IDLE_TIMEOUT_MS=
VITE_AI_WS_STOP_FALLBACK_MS=

# ── 关于版本显示（可选）─────────────────────────────────────────────
# 仅在「系统设置」页作为参考值展示，不参与任何逻辑判断。
VITE_APP_VERSION=
