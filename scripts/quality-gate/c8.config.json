{
  "all": true,
  "include": ["services/backend/src/**/*.js"],
  "exclude": [
    "**/*.test.js",
    "**/__tests__/**",
    "**/vendor/**",
    "**/generated/**",
    "**/coverage/**",
    ".cache/quality-gate/**"
  ],
  "check-coverage": true,
  "lines": 80,
  "functions": 80,
  "branches": 80,
  "statements": 80,
  "reporter": ["text-summary", "json-summary"],
  "reports-dir": ".cache/quality-gate/coverage"
}
