{
  "all": true,
  "include": ["services/backend/src/**/*.js"],
  "exclude": ["**/*.test.js", "**/__tests__/**", "**/vendor/**", "**/generated/**", "**/coverage/**", ".cache/quality-gate/**"],
  "check-coverage": true,
  "lines": 60,
  "functions": 60,
  "branches": 60,
  "statements": 60,
  "reporter": ["text-summary", "json-summary"],
  "reports-dir": ".cache/quality-gate/coverage"
}
