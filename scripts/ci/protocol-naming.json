  "_methodPatternNote": "排除文件名误报：末段若是常见文件扩展名（a2a.test.js / a2a.spec.ts）不算方法名。",
  "forbiddenMethodPattern": "\\ba2a\\.[a-z][a-z0-9_]*\\.(?!(?:js|ts|tsx|mjs|cjs|json|md|html|yml|yaml|vue|txt)\\b)[a-z][a-z0-9_]*\\b",
  "forbiddenMethodHint": "a2a.<域>.<动作> 形式的方法名在实现中零存在（实测只出现在文档里）。私有 ACP 的真实方法集见 acpTransport.ACP_METHODS。",
