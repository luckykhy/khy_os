{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Integrity Manifest",
  "description": "The .khy/integrity_manifest.json file tracks file hashes for integrity verification.",
  "type": "object",
  "required": ["version", "timestamp"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Manifest schema version (e.g. 1)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this manifest was generated"
    },
    "generator": {
      "type": "string",
      "description": "Tool that generated this manifest"
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "object",
      "description": "Map of relative path → SHA-256 hash string",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "additionalProperties": true
}
