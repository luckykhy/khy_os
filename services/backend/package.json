{
  "name": "khy-os-backend",
  "version": "1.1.10",
  "description": "Khy OS AI platform backend with default app runtime",
  "main": "server.js",
  "bin": {
    "khyquant": "./bin/khy.js",
    "khy-os": "./bin/khy.js",
    "khy": "./bin/khy.js"
  },
  "files": [
    "bin/khy.js",
    "bin/khy-os-init.js",
    "src/",
    "config/",
    "scripts/",
    "sql/",
    "migrations/",
    "assets/",
    "akshare_scripts/",
    "wasm-chain/",
    "wasm-context/",
    "wasm-indicators/",
    "vendor/",
    "server.js",
    "setup.js",
    "start-with-db.js",
    "check-env.js",
    "reset-database.js",
    "create-test-users.js",
    "test-db-connection.js",
    "inference_server.py",
    "babel.config.json",
    "esbuild.config.js",
    "jsconfig.json",
    "README*"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:db": "node start-with-db.js",
    "migrate": "node src/migrations/run.js",
    "arch:debt": "node scripts/archDebtScan.js",
    "arch:debt:baseline": "node scripts/archDebtScan.js --update-baseline",
    "arch:god": "node scripts/archDebtScan.js --god-report",
    "test": "jest",
    "test:node": "node --test tests/**/*.test.js",
    "test:all": "npm test && npm run test:node",
    "test:summary": "node scripts/test-summary.js",
    "test:tui": "node scripts/run-ink-tui-tests.js",
    "test-db": "node test-db-connection.js",
    "check-env": "node check-env.js",
    "reset-db": "node reset-database.js",
    "create-users": "node create-test-users.js",
    "seed": "node scripts/seed.js",
    "cli": "node bin/khy.js",
    "setup": "node setup.js",
    "prepack": "node scripts/prepack.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"server.js\" \"setup.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"server.js\" \"setup.js\"",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "precommit": "lint-staged"
  },
  "keywords": [
    "ai-os",
    "agent-platform",
    "express",
    "postgresql"
  ],
  "author": "孔浩原",
  "license": "LicenseRef-Source-Available",
  "homepage": "https://github.com/kodehu03/khy-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodehu03/khy-os.git"
  },
  "bugs": {
    "url": "https://github.com/kodehu03/khy-os/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@aws/codewhisperer-streaming-client": "^1.0.45",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@khy/shared": "file:./vendor/shared",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@simplewebauthn/server": "^13.3.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "iconv-lite": "^0.7.3",
    "ink": "^7.1.1",
    "inquirer": "^14.0.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "node-stream-zip": "^1.16.0",
    "ora": "^9.4.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "redis": "^4.7.1",
    "sequelize": "^6.35.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --check",
      "eslint --max-warnings 999"
    ]
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0",
    "glob": "^10.3.10",
    "https-proxy-agent": "^9.1.0",
    "node-llama-cpp": "^3.18.1",
    "node-pty": "^1.0.0",
    "string-width": "^8.2.2"
  }
}
