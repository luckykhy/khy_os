# ============================================================
# khy-os 环境变量模板 — 复制为 .env 后填写实际值
# ============================================================

# 认证（必填，或留空让 ensureAuthSecret.js 自动生成）
# JWT_SECRET=

# 数据库（可选，默认 SQLite）
# KHY_DB_DIALECT=sqlite
# KHY_DB_URL=

# 默认管理员自动初始化（可选）
# 后端启动时自动创建默认管理员 admin/admin123（已存在则跳过，不会覆盖）
# KHY_ADMIN_AUTO_INIT=1        # 设为 0 或 false 可禁用自动初始化
# KHY_ADMIN_USERNAME=admin     # 自定义默认管理员用户名
# KHY_ADMIN_PASSWORD=admin123  # 自定义默认管理员密码（设置后不会打印到日志）

# ── 复杂任务可交付性（可选）──────────────────────────────
# 会话消息历史上限（条数），默认 160。复杂任务几十轮工具循环后仍保留早期任务上下文。
# KHY_MAX_HISTORY=160
# 工具循环最大轮数（按任务规模分档，默认 large=20 / normal=12 / small=4）。
# KHY_TOOL_LOOP_MAX_LARGE=20
# KHY_TOOL_LOOP_MAX=12
# KHY_TOOL_LOOP_MAX_SMALL=4
# 工具循环耗尽后自动汇总工具结果生成最终交付总结（默认开；0/false 关）。
# KHY_TOOL_LOOP_WRAPUP=1
# 输出被 max_tokens 截断且正文为空时自动续写一次（默认开；0/false 关）。
# KHY_EMPTY_AUTO_CONTINUE=1

# ── 多渠道级联更新（可选）────────────────────────────────
# 发布轨道仅接受 stable / preview / dev，与下面的发布源开关相互独立。
# KHY_UPDATE_CHANNEL=stable
# KHY_UPDATE_GITHUB_REPOSITORY=luckykhy/khy_os
# KHY_UPDATE_ENABLE_GITHUB=1
# KHY_UPDATE_ENABLE_PYPI=1
# KHY_UPDATE_ENABLE_NPM=1
# KHY_UPDATE_ENABLE_LOCAL=1
# 网络探测单渠道最多 8 秒，整个级联最多 10 秒。
# KHY_UPDATE_PROBE_TIMEOUT_MS=8000
# KHY_UPDATE_PROBE_TOTAL_TIMEOUT_MS=10000
# 下载期间连续 10 秒没有收到字节才中止。
# KHY_UPDATE_DOWNLOAD_IDLE_TIMEOUT_MS=10000
# 非 TTY 日志中，同一更新阶段最快每 1 秒输出一条进度。
# KHY_UPDATE_PROGRESS_MIN_INTERVAL_MS=1000
# 设为 0 可关闭更新进度输出，恢复为仅输出阶段结果。
# KHY_UPDATE_STREAM_PROGRESS=1

# ── 可观测性（全部可选，默认值见 src/constants/serviceDefaults.js 的 OBSERVABILITY 块）──
#
# 隐私红线：以下所有遥测数据只写本地 .khy/ 目录，绝不外传。唯一会发出网络请求的
# 是 OTLP 导出（KHY_OTEL_*），且默认关闭，需显式开启并自行指定 endpoint。
#
# Prometheus 指标端点（默认开启，路径 /metrics）
# KHY_METRICS_ENABLED=1
# KHY_METRICS_PATH=/metrics
# KHY_METRICS_PREFIX=khy_
# 生产环境必须设置，否则 /metrics 一律返回 401（Bearer 认证）。
# METRICS_SECRET=

# OpenTelemetry 链路追踪（默认关闭；开启需先装 @opentelemetry/sdk-node 等 peer 包）
# KHY_OTEL_ENABLED=0
# 导出器：console（默认，仅打印到本地）/ otlp（会向下面的 endpoint 发出网络请求）
# KHY_OTEL_EXPORTER=console
# KHY_OTEL_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# KHY_OTEL_OTLP_HEADERS=
# KHY_OTEL_SERVICE_NAME=khy-os-backend
# KHY_OTEL_SERVICE_VERSION=

# 事件日志（JSONL + 进程内事件总线，默认开启，落 .khy/events/）
# KHY_EVENTLOG_ENABLED=1
# KHY_EVENTLOG_SHARD=date
# KHY_EVENTLOG_DIR=

# 慢请求告警（默认关闭 —— 关闭时每个请求只多一次布尔判断）
# 开启后：越阈值的请求会写入聚合(.khy/telemetry/slow_requests.json)、
# 明细(.khy/monitor/slow-YYYY-MM-DD.jsonl)、事件日志与告警日志。
# KHY_SLOW_REQUEST_ENABLED=0
# 判定阈值（毫秒），>= 该值即算慢请求。
# KHY_SLOW_REQUEST_THRESHOLD_MS=3000
# 采样率 0~1（1=全采）。用确定性 token-bucket，不是随机数。
# KHY_SLOW_REQUEST_SAMPLE_RATE=1
# 同一路由的告警去抖窗口（毫秒），避免慢请求成批出现时刷屏。
# KHY_SLOW_REQUEST_ALERT_COOLDOWN_MS=60000
# 路由基数封顶 / 每路由分位样本环大小 / 明细分片保留天数。
# KHY_SLOW_REQUEST_MAX_ROUTES=200
# KHY_SLOW_REQUEST_MAX_SAMPLES=256
# KHY_SLOW_REQUEST_RETENTION_DAYS=7

# CPU profiling 与事件循环延迟监测（默认关闭 —— 关闭时不创建直方图、不起定时器）
# 开启后 `khy monitor profile` 可按需采样，产物落 .khy/monitor/profiles/*.cpuprofile。
# KHY_PROFILING_ENABLED=0
# 单次采样默认时长 / 上限（毫秒）与采样间隔（微秒）。
# KHY_PROFILING_DURATION_MS=10000
# KHY_PROFILING_MAX_DURATION_MS=120000
# KHY_PROFILING_SAMPLE_INTERVAL_US=1000
# 事件循环直方图分辨率 / 检查周期（毫秒）与 p99 告警阈值（毫秒）。
# KHY_EVENTLOOP_RESOLUTION_MS=20
# KHY_EVENTLOOP_CHECK_INTERVAL_MS=30000
# KHY_EVENTLOOP_LAG_THRESHOLD_MS=200

# ── 失败冷却 / 熔断 / 恢复 ——全部可选，下面写的都是默认值 ───────────────────
#
# 背景：网关有三层独立的「失败后暂时别用」机制，叠加起来曾经能把一条通道判死刑：
#   1) 单次失败的 fast-fail 冷却窗口（按错误类型给不同时长）
#   2) 连续失败计数触发的熔断（cooldown 指数放大，上限 300s）
#   3) API key 池的按 key 冷却（只有 429/403/401 与限流类文案会触发）
# 这些默认值适配大多数场景；只有在「网络本来就抖，但你希望更快重试」或者
# 「上游很脆弱，希望退得更狠」时才需要动。

# 连续失败计数的存活时间（毫秒）。计数在最后一次失败之后静默满该时长即归零。
# 无 Redis 的默认安装以前**没有**这个衰减：计数只增不减，于是一旦被推高，之后
# 任意一次失败都直接撞熔断阈值且退避已饱和到上限 —— 表现就是「一次失败永久失败」。
# 调小 ⇒ 通道更快「忘记」历史失败；调大 ⇒ 对反复抖动的通道更记仇。下限 10s。
# GATEWAY_FAILURE_COUNT_TTL_MS=300000

# 熔断态下放行一次真实请求的最小间隔（毫秒，half-open 试探）。
# 熔断打开后冷却会指数放大到 300s，但**探测间隔不该跟着放大到 300s** —— 否则通道
# 恢复了也要等满一个冷却周期才被发现。这个值把探测间隔单独夹住：成功即立刻解除熔断。
# 设为 0 = 关闭熔断态放行（回到「熔断期间一律 fast-fail」的旧行为，不建议）。
# KHY_CIRCUIT_HALF_OPEN_PROBE_MS=30000

# 允许 half-open 试探的错误类型（逗号分隔）。只列「换条连接就可能好」的类型；
# auth / permission 这类确定性失败不该反复重试上游。
# KHY_FAST_FAIL_PROBE_TYPES=unknown,network,timeout

# API key 池的按 key 退避：第 n 次触发冷却 → BASE · 2^(n-1)，取 MAX 为上限，
# 级数取 MAX_BACKOFF_LEVEL 为上限。默认 10s→20→40→80→160s，封顶 300s。
# 注意：网络抖动（ECONNRESET / socket hang up）只记失败计数、**不**冷却 key ——
# 换条连接就能好的错误不该停用一把好 key。
# KHY_API_KEY_POOL_BASE_COOLDOWN_MS=10000
# KHY_API_KEY_POOL_MAX_COOLDOWN_MS=300000
# KHY_API_KEY_POOL_MAX_BACKOFF_LEVEL=5
# 服务端 Retry-After 的上界。上游给出的秒数不可无条件信任（实测见过 86400）：
# 没有这个夹子，一个坏响应就能把一把好 key 停用一整天。
# KHY_API_KEY_POOL_MAX_RETRY_AFTER_MS=600000

# ── 记忆语义检索（RAG）——全部可选，下面写的都是默认值 ─────────────────────
#
# 隐私红线：记忆向量只写本地侧车文件 <记忆目录>/.vectors.json，不上报任何远端。
# embedding 请求只发往你自己配置的端点（本地 Ollama 优先，其次本项目网关），
# 记忆模块本身不直连任何供应商 API。
#
# 降级承诺：embedding 后端打不通时，召回自动退回「纯关键词 × 时间衰减」的旧行为，
# 分值与顺序逐字节一致，记忆功能不会因为 RAG 故障而中断。所以以下开关全部留空
# 也能正常用；只有想调检索行为时才需要动。

# 语义召回总开关。关掉 ⇒ 只走关键词召回，一次 embedding 请求都不发。
# KHY_MEMORY_VECTOR_RECALL=1
# 嵌入模型（留空则回落 KHY_LEARN_EMBED_MODEL，再回落 nomic-embed-text）。
# 换了模型 ⇒ 整张向量表自动作废重建（不同模型的向量空间不可比，混用会静默错排）。
# KHY_MEMORY_EMBED_MODEL=nomic-embed-text
# 自定义 embedding 端点（openai 兼容）。留空则按 Ollama → 本项目网关的顺序探测。
# KHY_LEARN_EMBED_URL=
# 单次请求超时 / 探活超时 / 单请求最多几条文本 / 可用性缓存有效期（毫秒）。
# KHY_LEARN_EMBED_TIMEOUT_MS=4000
# KHY_LEARN_PROBE_TIMEOUT_MS=1200
# KHY_LEARN_EMBED_MAX_TEXTS=16
# KHY_EMBED_AVAILABILITY_TTL_MS=60000

# 相关性评分：score = (W_LEX·lexNorm + W_SEM·semNorm) × recency
#   lexNorm = keywordScore / (池内最大 keywordScore + LEX_SOFT)
#   semNorm = max(0, (cos - FLOOR) / (1 - FLOOR))
# 语义地板：余弦低于此值的候选记 0 分并被丢弃。这是「语义相关」与「都是中文散文」
# 的分界线；调低会放宽召回，也更容易召回噪声。
# KHY_MEMORY_VECTOR_FLOOR=0.35
# 语义信号权重（关键词得 1 - 此值）。1 = 纯语义，0 = 纯关键词。
# KHY_MEMORY_VECTOR_WEIGHT=0.5
# 关键词归一化的加性平滑量。0 ⇒ 退回「池内最大值归一化」，那会让池里最好的那条
# 无论多弱都拿满分（三个共享虚词就能压过一次完美语义命中）。
# KHY_MEMORY_LEX_SOFT=6
# 语义候选池大小 = limit × 此系数。
# KHY_MEMORY_VECTOR_POOL_FACTOR=4
# 时间衰减半衰期按留存层分档（关掉 ⇒ 所有层共用一个 KHY_MEMORY_HALFLIFE_DAYS）。
# permanent 永不按时间衰减；short_term 用下面这个短半衰期。
# KHY_MEMORY_TIER_HALFLIFE=1
# KHY_MEMORY_HALFLIFE_DAYS=30
# KHY_MEMORY_HALFLIFE_SHORT_DAYS=1

# 单回合最多为多少条「尚无缓存向量」的记忆做嵌入（有界，防冷启动卡顿）。
# KHY_MEMORY_VECTOR_EMBED_PER_TURN=32
# 参与嵌入的正文截断长度（字符）。
# KHY_MEMORY_VECTOR_SNIPPET_CHARS=500

# 向量存储后端。目前只实现 file（JSON 侧车）；sqlite 是预留值，写了也仍走 file。
# KHY_MEMORY_VECTOR_STORE=file
# 落盘量化小数位 / 侧车字节上限（超限即拒写，不留半张表）。
# KHY_MEMORY_VECTOR_PRECISION=6
# KHY_MEMORY_VECTOR_MAX_BYTES=33554432
# 记录「哪条记忆被召回过几次」（为后续冷记忆降权准备）。默认关闭。
# 铁律 F5：衰减只降权、不删除；自动删除记忆必须经用户确认。
# KHY_MEMORY_VECTOR_HITS=0

# 项目记忆注入（aiSession）：按相关性排序后再填 5000 字符预算。
# 关掉 ⇒ 退回按 MEMORY.md 原始顺序整文件读取。
# KHY_PROJECT_MEMORY_RANKED=1


# ─── 审计日志（src/services/auditLog.js） ────────────────────────────────
# 工具执行审计写入 ~/.khyquant/audit.jsonl（JSONL，逐行 append）。
# 隐私红线：审计只存本地，绝不外传；params 中的密码/密钥一律落为 ***，
# 以 _ 开头的字段整条丢弃。
# 单文件轮转阈值（字节）。超过即 audit.jsonl → .1 → .2 → .3，最旧的丢弃。
# KHY_AUDIT_MAX_BYTES=10485760
# 保留几份历史。设 0 ⇒ 超限直接重置，不留历史。
# KHY_AUDIT_MAX_BACKUPS=3
# result.error 只保留首句，并硬截断到此长度（字符）。
# KHY_AUDIT_ERROR_CHARS=200
# 单个 param 值（含嵌套对象序列化后）的截断长度，超出会标注 "... (N chars)"。
# KHY_AUDIT_PARAM_CHARS=200
# 幂等窗口（毫秒）：同一次执行在窗口内重复上报只落一行。
# 设 0 ⇒ 完全不去重，恢复「每次调用都写一行」的旧行为。
# KHY_AUDIT_DEDUPE_WINDOW_MS=2000
# 幂等指纹记忆条数上限（有界，防长会话内存增长）。
# KHY_AUDIT_DEDUPE_MEMORY=64

# ─── 上下文压缩透明度（src/services/contextCompressor.js） ──────────────
# 压缩被跳过/降级/失败时，向终端打一行「动作 + 目标 + 进度」提示。
# 关掉 ⇒ 退回只写 logger，不在终端露出（旧行为）。
# KHY_COMPACT_NOTICE=1
# 把压缩链路的跳过/降级/成功写进审计（tool 名 context-compress[-skip|-degrade]）。
# 关掉 ⇒ 只打提示不落盘。
# KHY_COMPACT_AUDIT=1
