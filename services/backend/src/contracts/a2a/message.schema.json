{
  "$id": "message.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A2A Message",
  "description": "Agent2Agent (A2A) Protocol v0.3.0 Message + Part model. A Message is a single communication turn; content is carried in a discriminated `parts` array of TextPart / FilePart / DataPart (spec-06-data-objects).",
  "type": "object",
  "additionalProperties": true,
  "required": ["role", "parts", "messageId"],
  "properties": {
    "kind": { "type": "string", "enum": ["message"] },
    "role": {
      "type": "string",
      "enum": ["user", "agent"],
      "description": "Who produced this turn."
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Part" }
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique id of THIS message (not the task)."
    },
    "taskId": { "type": "string" },
    "contextId": {
      "type": "string",
      "description": "Server-generated id grouping related tasks in one conversation."
    },
    "referenceTaskIds": { "type": "array", "items": { "type": "string" } },
    "extensions": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  },
  "definitions": {
    "Part": {
      "description": "Discriminated union keyed on `kind`.",
      "oneOf": [
        { "$ref": "#/definitions/TextPart" },
        { "$ref": "#/definitions/FilePart" },
        { "$ref": "#/definitions/DataPart" }
      ]
    },
    "TextPart": {
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["text"] },
        "text": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "FilePart": {
      "type": "object",
      "required": ["kind", "file"],
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["file"] },
        "file": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "mimeType": { "type": "string" },
            "bytes": { "type": "string", "description": "base64-encoded inline content." },
            "uri": { "type": "string", "description": "Out-of-band file reference; mutually exclusive with bytes." }
          },
          "anyOf": [{ "required": ["bytes"] }, { "required": ["uri"] }]
        },
        "metadata": { "type": "object" }
      }
    },
    "DataPart": {
      "type": "object",
      "required": ["kind", "data"],
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["data"] },
        "data": { "type": "object", "description": "Structured JSON payload." },
        "metadata": { "type": "object" }
      }
    }
  }
}
