{
  "$id": "task.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A2A Task",
  "description": "Agent2Agent (A2A) Protocol v0.3.0 Task + TaskStatus + Artifact model (spec-06-data-objects). TaskState is a CLOSED enum — khy-os internal lifecycles must map onto it rather than inventing private states.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "contextId", "status"],
  "properties": {
    "kind": { "type": "string", "enum": ["task"] },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Server-generated task id."
    },
    "contextId": {
      "type": "string",
      "minLength": 1,
      "description": "Server-generated id grouping related tasks."
    },
    "status": { "$ref": "#/definitions/TaskStatus" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/Artifact" }
    },
    "history": {
      "type": "array",
      "description": "Prior Message turns of this task, oldest first.",
      "items": { "$ref": "message.schema.json" }
    },
    "metadata": { "type": "object" }
  },
  "definitions": {
    "TaskState": {
      "type": "string",
      "description": "A2A v0.3.0 TaskState — closed set. Terminal: completed, canceled, failed, rejected.",
      "enum": [
        "submitted",
        "working",
        "input-required",
        "completed",
        "canceled",
        "failed",
        "rejected",
        "auth-required",
        "unknown"
      ]
    },
    "TaskStatus": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": true,
      "properties": {
        "state": { "$ref": "#/definitions/TaskState" },
        "message": {
          "description": "Optional agent message accompanying this state (e.g. the question asked in input-required).",
          "$ref": "message.schema.json"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of this status."
        }
      }
    },
    "Artifact": {
      "type": "object",
      "required": ["artifactId", "parts"],
      "additionalProperties": true,
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "message.schema.json#/definitions/Part" }
        },
        "metadata": { "type": "object" },
        "extensions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
