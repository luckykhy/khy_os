# Dependencies
node_modules/
__pycache__/
*.pyc
.pnp.*
.yarn/

# Build outputs
dist/
build/
*.egg-info/
# Exception: packaging/build/ holds CI build scripts (source, not output).
# The broad build/ rule above must not swallow them, or the
# Build Standalone Executables workflow fails with MODULE_NOT_FOUND.
!packaging/build/
!packaging/build/*.js
!packaging/build/*.json
*.iso
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment & secrets
.env
.env.local
.env.*.local

# Local data directories
.khy/
.khyquant/
.khyquant-data/
.khy-Trajectory/
khy-Trajectory/
# Legacy root-level khyquant data locations — migrated to .khy/khyquant/{cache,data,temp}
# on 2026-08-13; rules kept so legacy code paths never leak them back into git.
/cache/
/data/
.khyos/
.runtime/
.khy-runtime/

# khyquant runtime scratch (lives in .khy/khyquant/temp since 2026-08-13 migration)
/software/temp/
/software/data/

# Backend runtime stamp / marker files (written at install/configure time)
.khy_*
.agnes-test-*/

# Local git worktrees created by Claude Code (EnterWorktree). Never a repo artifact:
# .claude/worktrees/<name> was once committed as a mode-160000 gitlink by accident.
.claude/worktrees/

# IDE / OS artifacts
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Logs & temp
logs/
*.log
tmp/
.tmp/
*.pid
*.seed

# Platform packages
platform/packages/*
!platform/packages/shared/
!platform/packages/shared/**
!platform/packages/ui-shared/
!platform/packages/ui-shared/**

# Frontend build artifacts
apps/ai-frontend/dist/
apps/ai-frontend/.vite/

# Test coverage
coverage/
.nyc_output/

# Git
.gitignore.orig

# Misc
*.orig
*.rej
.cache/

# Large binary archives (encrypted snapshot & prebuild)
# 注意：含 `/` 的模式锚定在仓库根，`_source/...` 只挡得住根级 _source/，
# 挡不住 services/backend/_source/ —— 用 `**/` 前缀覆盖任意层级。
**/_source/*.tar.gz.enc
_bs3_prebuild.tar.gz

# 可再生构建产物：committed 副本一律由源码重建，不进 git。
#   bundled/runtime/khy/bundle.mjs —— esbuild 产物，发布前由 assemble 脚本重建：
#     pip: scripts/release/assemble-pip-runtime.js（先 rmSync 整树再重建）
#     npm: packaging/npm/scripts/assemble.js（prepack 每次发包前跑）
#   git checkout 下 platform/khy_platform/cli.py 优先走源码树，从不读这两个文件。
platform/khy_platform/bundled/
packaging/npm/bundled/
#   apps/ai-frontend/public/vendor/ —— extensions/tools/khy-markdown/vendor/ 的字节级镜像，
#   由 apps/ai-frontend 的 predev/prebuild 钩子调 sync-md-vendor.mjs 自动同步。
apps/ai-frontend/public/vendor/
#   extensions/tools/khy-markdown/vendor/ —— muya WYSIWYG 引擎的 esbuild 自打包产物（11 MB），
#   源码是同级 muya-embed/（@muyajs/core@0.2.0 + build.mjs），重建逐字节可复现。
#   守卫 muya-embed/ensure-vendor.mjs 挂在三处：khy-markdown 拓展的 prepack、
#   scripts/release/build-payload-assets.js（Release 的 markdown-vendor payload）、
#   apps/ai-frontend 的 sync-md-vendor.mjs（fail-soft，缺则回退内联渲染器）。
#   打包层早已 prune 它：MANIFEST.in + pip_packaging_rules.py:SDIST_PRUNE_DIRS。
#   附带收益：跟踪时 Windows 的 autocrlf 会在检出时把它撑大 4112 字节。
extensions/tools/khy-markdown/vendor/
#   docs/_assets/mermaid.min.js —— mermaid@11.15.0 的 esbuild 自打包产物（3.3 MB），
#   源码是 scripts/docs/mermaid-embed/；由 npm run docs:build 的 ensure 步骤重建。
#   同目录的 docs-site.css / docs-site.js / hljs-*.css 是手写源码，继续跟踪。
docs/_assets/mermaid.min.js


# Debug/test artifacts
#   ai-gateway-failures.json —— jest --json --outputFile 的残留汇总，无生产者。
ai-gateway-failures.json
#   publish/ —— scripts/release/build-payload-assets.js 的默认输出目录（--out 不给时），
#   一跑就是 38 MB 的 Release 资产（加密源码快照 + muya 产物）。此前**未被忽略**，
#   任何一次 `git add -A` 都会把它整包提交进来。
publish/
_dbg_*
_repl_*
_smoke_*

# Vendored tooling & reference material
# deepseek-eyes source is distributed with khy; its local runtime stays untracked.
tools/deepseek-eyes/.venv/
tools/deepseek-eyes/**/__pycache__/
tools/deepseek-eyes/**/*.py[cod]
tools/deepseek-eyes/*.egg-info/
tools/deepseek-eyes/.env
tools/deepseek-eyes/.env.local
docs/_ref/

# Root-level scratch / ad-hoc probe scripts (keep project root clean)
/__*
/_fix_*
/jest-full-output.txt
/test-results.txt
/test_*.js
/test_*.py

# Windows device-name redirection artifacts (PowerShell `> NUL` creates literal files)
NUL
nul

# khy portable sync 在目标根生成的运行时记录（含机器本地 sourceRoot），不应入库
.sync-manifest.json
