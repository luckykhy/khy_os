# Dependencies
node_modules/
__pycache__/
*.pyc
.pnp.*
.yarn/

# Build outputs
dist/
build/
# Exception: packaging/build/ holds CI build scripts (source, not output).
# The broad build/ rule above must not swallow them, or the
# Build Standalone Executables workflow fails with MODULE_NOT_FOUND.
!packaging/build/
!packaging/build/*.js
!packaging/build/*.json
*.iso
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment & secrets
.env
.env.local
.env.*.local

# Local data directories
.khy/
.khyquant/
.khyquant-data/
.khy-Trajectory/
khy-Trajectory/
/cache/

# IDE / OS artifacts
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Logs & temp
logs/
*.log
tmp/
.tmp/
*.pid
*.seed

# Platform packages
platform/packages/

# Frontend build artifacts
apps/ai-frontend/dist/
apps/ai-frontend/.vite/

# Test coverage
coverage/
.nyc_output/

# Git
.gitignore.orig

# Misc
*.orig
*.rej
.cache/

# Large binary archives (encrypted snapshot & prebuild)
_source/khy-os-source.tar.gz.enc
_bs3_prebuild.tar.gz
